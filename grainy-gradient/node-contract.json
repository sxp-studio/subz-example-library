{
  "title": "Grainy Gradient",
  "sfSymbol": "circle.lefthalf.striped.horizontal",
  "summary": "A two-colour gradient with film grain over it. The grain is what keeps the blend from banding.",
  "inputs": [
    { "name": "topColor", "type": "colorRGB", "default": { "type": "colorRGB", "value": [0.98, 0.45, 0.36] }, "ui": { "kind": "colorWell" } },
    { "name": "bottomColor", "type": "colorRGB", "default": { "type": "colorRGB", "value": [0.20, 0.16, 0.42] }, "ui": { "kind": "colorWell" } },
    { "name": "angle", "type": "float", "default": { "type": "float", "value": 20.0 }, "ui": { "kind": "slider", "min": 0.0, "max": 360.0, "step": 1.0 } },
    { "name": "softness", "type": "float", "default": { "type": "float", "value": 0.5 }, "ui": { "kind": "slider", "min": 0.0, "max": 1.0, "step": 0.01 } },
    { "name": "grain", "type": "float", "default": { "type": "float", "value": 0.14 }, "ui": { "kind": "slider", "min": 0.0, "max": 0.4, "step": 0.005 } },
    { "name": "grainSize", "type": "float", "default": { "type": "float", "value": 1.0 }, "ui": { "kind": "slider", "min": 0.5, "max": 8.0, "step": 0.1 } }
  ],
  "outputs": [
    { "name": "output", "type": "texture", "display": true }
  ]
}
